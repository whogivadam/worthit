{
  "manifest_version": 3,
  "name": "Worth It?",
  "version": "0.0.0",
  "description": "Turn any price into the hours of work it costs you, in the popup and next to prices on any shop.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Worth It?"
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://open.er-api.com/*",
    "https://api.frankfurter.app/*",
    "https://api.frankfurter.dev/*"
  ],
  "background": {
    "scripts": [
      "lib/rates.js",
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/currencies.js",
        "lib/parser.js",
        "lib/calc.js",
        "lib/rates.js",
        "content/content.js"
      ],
      "css": [
        "content/badge.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "worthit-ext@proton.me",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
